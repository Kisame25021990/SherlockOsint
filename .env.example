# Timeout par défaut pour Sherlock (secondes)
SHERLOCK_TIMEOUT=20

# Timeout des requêtes HTTP/DNS des autres modules
REQUEST_TIMEOUT=10

# Nombre maximal de scans simultanés
MAX_CONCURRENT_SCANS=3

# Utiliser la liste de sites Sherlock distante au lieu de celle embarquée
# SHERLOCK_USE_REMOTE_SITES=0

# Proxy global optionnel (ex: socks5://127.0.0.1:9050)
# OSINT_PROXY=socks5://127.0.0.1:9050

# Chemins relatifs au répertoire depuis lequel le serveur est lancé
# OSINT_DB_PATH=./backend/osint.db
# OSINT_STATIC_DIR=./frontend

# Origines autorisées pour le navigateur (séparées par des virgules)
# OSINT_CORS_ORIGINS=http://127.0.0.1:8000

# Authentification Basic (à définir impérativement si le service est exposé)
# OSINT_AUTH_USER=admin
# OSINT_AUTH_PASSWORD=changez-moi

# Clés API optionnelles (modules avancés)
# HIBP_API_KEY=
# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
